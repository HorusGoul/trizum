{
  "extends": "@trizum/tsconfig/base.json",
  "include": ["./src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "lib": ["ES2022", "DOM"],
    "target": "ES2022"
  }
}
