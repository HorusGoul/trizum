{
  "extends": "@trizum/tsconfig/base.json",
  "include": ["./src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react"]
  }
}
