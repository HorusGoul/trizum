{
  "extends": "./tsconfig.json",
  "include": ["./src"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  }
}
