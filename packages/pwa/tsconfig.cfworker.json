{
  "compilerOptions": {
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "composite": true,
    "skipLibCheck": true
  },
  "include": [
    "./api/**/*.ts",
    "./api/types.d.ts",
    "./src/lib/authConfig.ts",
    "./src/lib/locales.ts",
    "./src/lib/log.ts",
    "./src/lib/partySharePreviewMessages.ts",
    "./src/lib/api/*.ts",
    "./src/lib/money.ts",
    "./src/lib/recalculatePartyBalances.ts",
    "./src/lib/mcpMessages.ts",
    "./src/lib/aiInvite.ts",
    "./src/lib/routerSearch.ts",
    "./src/models/expense.ts",
    "./src/lib/tricountMigration.ts",
    "./src/models/migrationData.ts",
    "./src/models/party.ts"
  ]
}
