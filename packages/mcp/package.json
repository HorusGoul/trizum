{
  "name": "@trizum/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous trizum parties and expenses for ChatGPT and MCP agents",
  "keywords": [],
  "license": "MIT",
  "author": "Horus Lugo <hola@horus.dev> (https://horus.dev)",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#*": "./*"
  },
  "exports": {
    "./widget.css": "./dist/widget.css",
    "./widget.svg": "./dist/widget.svg",
    "./widget.js": "./dist/widget.js",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "cleanup": "rm -rf dist",
    "dev": "tsc -b tsconfig.json --watch"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@trizum/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@trizum/icon-sprite": "workspace:*",
    "@trizum/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
